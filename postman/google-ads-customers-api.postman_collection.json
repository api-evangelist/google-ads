{
  "info": {
    "_postman_id": "7659b688-54c4-4288-94ab-9a34d9ea82f5",
    "name": "Google Ads Ad Groups Customers API",
    "description": "The Google Ads API is the modern programmatic interface to Google Ads and the\nnext generation of the AdWords API. It enables developers to interact directly\nwith the Google Ads platform, vastly increasing the efficiency of managing\nlarge or complex Google Ads accounts and campaigns. The API allows for\ncreating, reading, updating, and removing campaigns, ad groups, ads, keywords,\nand retrieving performance reports using Google Ads Query Language (GAQL).\n\n\nContact Support:\n Name: Google Ads API Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:45:04.000Z",
    "updatedAt": "2026-07-28T01:45:05.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-7659b688-54c4-4288-94ab-9a34d9ea82f5"
  },
